                        <Textbox Name="LblRemarks">
                          <Top>0.4cm</Top>
                          <Left>0.2cm</Left>
                          <Width>9.5cm</Width>
                          <Height>0.5cm</Height>
                          <Value>Manager Remarks:</Value>
                          <Style>
                            <FontFamily>Segoe UI</FontFamily>
                            <FontSize>8pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <Color>#555555</Color>
                            <VerticalAlign>Middle</VerticalAlign>
                          </Style>
                        </Textbox>
                        <Rectangle Name="RemarksBox">
                          <Top>1.0cm</Top>
                          <Left>0.2cm</Left>
                          <Width>9.8cm</Width>
                          <Height>2.8cm</Height>
                          <Style>
                            <BorderStyle>
                              <Default>Solid</Default>
                            </BorderStyle>
                            <BorderColor>
                              <Default>#CCCCCC</Default>
                            </BorderColor>
                            <BorderWidth>
                              <Default>0.5pt</Default>
                            </BorderWidth>
                            <BackgroundColor>#FAFAFA</BackgroundColor>
                          </Style>
                        </Rectangle>
                        <Textbox Name="ValRemarks">
                          <Top>1.1cm</Top>
                          <Left>0.4cm</Left>
                          <Width>9.5cm</Width>
                          <Height>2.6cm</Height>
                          <CanGrow>true</CanGrow>
