                          <Height>0.5cm</Height>
                          <Value>Manager Signature:</Value>
                          <Style>
                            <FontFamily>Segoe UI</FontFamily>
                            <FontSize>8pt</FontSize>
                            <Color>#444444</Color>
                          </Style>
