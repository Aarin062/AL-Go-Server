                          <Style>
                            <FontFamily>Segoe UI</FontFamily>
                            <FontSize>8pt</FontSize>
                            <Color>#333333</Color>
                          </Style>
                        </Textbox>
                        <!-- ────────────────────────────
                             SIGNATURES
                             ──────────────────────────── -->
                        <!-- Section header -->
                        <Textbox Name="LblSignSection">
